# Machine-local overrides for claude-autowake.
#
# Copy to ~/.claude-autowake/local.env and fill in. That path — not this
# repo — is where the real file lives, so the checkout and the installed
# copy in ~/.claude-autowake/bin/ read the same one and no secret can be
# committed. No sync.sh run is needed after editing it.
#
# Format is KEY=value, one per line. Values are read key by key, so nothing
# here executes as shell code: no command substitution, no $VAR expansion,
# no arrays. Quotes around a value are optional and get stripped.

# Uptime Kuma Push monitor URL. Secret — anyone holding it can forge this
# machine's heartbeat. Leave unset to disable the push entirely.
KUMA_PUSH_URL=

# Absolute path to the claude CLI. Defaults to ~/.local/bin/claude, so only
# set this on a machine where claude lives somewhere else.
#CLAUDE_BIN=/opt/homebrew/bin/claude
